# ---- monday.com ----
# Personal API token: monday.com > Avatar (bottom left) > Admin > API
MONDAY_API_TOKEN=

# Workspace/board names as they appear in monday.com (used for auto-discovery,
# see src/lib/monday/boards.ts). Change these if you rename the boards.
MONDAY_WORKSPACE_NAME="Skylark"
MONDAY_DEALS_BOARD_NAME="Deal funnel Data"
MONDAY_WORK_ORDERS_BOARD_NAME="Work_Order_Tracker Data"

# Optional: skip name-based discovery and pin exact board IDs instead
# (faster, and immune to renames). Find these in the board URL.
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# ---- Gemini (agent brain) ----
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# gemini-2.0-flash has been retired by Google. gemini-3.6-flash is current
# stable as of writing; check https://ai.google.dev/gemini-api/docs/models
# if this ever 404s and update here (no code changes needed).
GEMINI_MODEL=gemini-3.6-flash
